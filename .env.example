# Injected by the agent host at runtime; listed here for local dev.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENROUTER_API_KEY=
ELEVENLABS_API_KEY=
HEDRA_API_KEY=
HEDRA_BASE_URL=
BUCKET=
AWS_REGION=
PROJECT_WORKSPACE_ROOT=
AGENT_PROJECT_ID=
# where the runtime mirrors every project workspace (/mnt in production, unset on a laptop)
EFS_PATH=
# OpenSearch domain holding internal_documents; unset disables the `documents` source
OPENSEARCH_URL=

# desk-shorts knobs (all optional)
SHORTS_TEXT_MODEL=gpt-5-mini
SHORTS_LANG=en
SHORTS_STYLE=
# empty: google/gemini-2.5-flash-image on OpenRouter, gpt-image-1 on OpenAI
SHORTS_IMAGE_MODEL=
SHORTS_VOICE_ID=
SHORTS_TTS_MODEL=gpt-4o-mini-tts
SHORTS_OPENROUTER_TTS_MODEL=minimax/speech-2.8-turbo
# transcribes the TTS mp3 back into word timings; needs a model that returns verbose_json
SHORTS_ALIGN_MODEL=openai/whisper-1
SHORTS_HEDRA_MODEL=kling-ai-avatar-v2
SHORTS_DESK_PROJECT_ID=3XXSRSd
SHORTS_SIGNAL_PROJECT_ID=SOWL83z
SHORTS_DOC_TYPES=sell_side_report,sell_side_comments,expert_call
# 1 keeps only names the firm holds or watches
SHORTS_COVERAGE_ONLY=

# plugin selection (see the Plugins section of the README)
SHORTS_RECIPE=classic
SHORTS_PERSONA=
SHORTS_VOICE=
SHORTS_AVATAR=
